msgid "Captcha code from image"
msgstr "छवि से कैप्चा कोड"

msgid "Captcha image"
msgstr "कैप्चा छवि"

msgid "Captcha was wrong"
msgstr "कैप्चा गलत था"

msgid "Contact"
msgstr "संपर्क"

msgid "Empty message"
msgstr "खाली संदेश"

msgid "Empty name"
msgstr "खाली नाम"

msgid "Empty subject"
msgstr "खाली विषय"

msgid "Enter code"
msgstr "कोड दर्ज करें"

msgid "Enter valid email"
msgstr "मान्य ईमेल दर्ज करें"

msgid "From"
msgstr "से"

msgid "Message"
msgstr "संदेश"

msgid "Paper in typewriter"
msgstr "टाइपराइटर में कागज"

msgid "Press \"{buttontext}\" to regenerate"
msgstr "पुनः उत्पन्न करने के लिए \"{buttontext}\" दबाएं"

msgid "Send message"
msgstr "संदेश भेजें"

