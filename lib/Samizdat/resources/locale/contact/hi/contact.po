msgstr "हम जल्द से जल्द उत्तर देंगे।"

msgid "Your email"
msgstr "आपका ईमेल"

msgid "Your ip {ip} will be appended to the message."
msgstr "आपका आईपी {ip} संदेश में जोड़ा जाएगा।"

msgid "Your message appears below."
msgstr "आपका संदेश नीचे दिखाई देता है।"

msgid "Your name"
msgstr "आपका नाम"
