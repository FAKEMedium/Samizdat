<div class="container">
  <div class="text-center text-muted py-5" id="loadingSpinner">
    <div class="spinner-border" role="status">
      <span class="visually-hidden"><%== __('Loading') %></span>
    </div>
  </div>

  <div id="userNotFound" class="d-none">
    <div class="alert alert-warning"><%== __('User not found') %></div>
  </div>

  <div id="userCard" class="d-none">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-start gap-3 mb-3">
          <img id="userImage" class="rounded-circle d-none" width="96" height="96" alt="" />
          <div>
            <h2 class="card-title mb-1" id="userDisplayName"></h2>
            <p class="text-muted mb-0" id="userOrganization"></p>
          </div>
        </div>
        <ul class="list-unstyled mb-3">
          <li id="userLocationRow" class="d-none">
            <i class="bi bi-geo-alt"></i>
            <span id="userCity"></span>
            <span id="userCountryFlag"></span>
          </li>
          <li id="userWebsiteRow" class="d-none">
            <i class="bi bi-globe"></i>
            <a id="userWebsite" href="#" target="_blank" rel="noopener noreferrer"></a>
          </li>
          <li id="userMemberSinceRow">
            <i class="bi bi-calendar"></i>
            <span id="userMemberSince"></span>
          </li>
        </ul>
        <div id="userPresentationText" class="mt-3"></div>
      </div>
    </div>
  </div>
</div>
