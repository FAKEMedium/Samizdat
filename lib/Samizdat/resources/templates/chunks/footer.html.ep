<div class="row">
  <div id="pagespeed" class="d-print-none col-4 col-auto">
    <a href="https://github.com/FAKEMedium/Samizdat" target="_blank" rel="noopener">
      <img src="/media/images/pagespeed.png" class="img-fluid" width="441" height="95" alt="<%== __('PageSpeed result 100 100 100 100') %>">
    </a>
  </div>
  <div class="col-8 col-auto text-end align-self-center">
% my $org_name = config->{organization}->{name};
% my $org_link = config->{organization}->{link};
% my $author = $org_link ? qq{<a href="$org_link" target="_blank" rel="noopener">$org_name</a>} : $org_name;
    <%== __x('&copy;{year}&nbsp;{author}', year => (localtime(time))[5] + 1900, author => $author) %>
  </div>
</div>
