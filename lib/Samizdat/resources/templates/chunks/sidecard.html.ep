<div class="card mb-3<%== exists($card->{editable}) ? ' editable' : '' %>" id="<%== $card->{docpath} %>"<%== exists($card->{src}) ? sprintf(' data-src="%s"', $card->{src}) : '' %>>
  <h2 class="card-header p-1 p-sm-2 title" id="<%== $card->{docpath} %>-title"><%== $card->{title} %></h2>
% if ($card->{card_image}) {
  <%== $card->{card_image} %>
% }
  <div class="card-body p-1 p-sm-2" id="<%== $card->{docpath} %>-content">
    <%== web->indent($card->{main}, 2) =%>
  </div>
</div>