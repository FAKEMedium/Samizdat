      <th><%== __('First name') %></th>
      <th><%== __('Last name') %></th>
    </tr>
  </thead>
  <tbody>
  </tbody>
</table>
<table class="table table-sm table-striped sortable d-none" id="mycustomers">
  <thead>
    <tr>
      <th><%== __('Customer Id') %></th>
      <th><%== __('Company') %></th>
      <th><%== __('Name') %></th>
      <th><%== __('Roles') %></th>
