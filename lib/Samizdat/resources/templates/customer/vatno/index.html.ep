<div class="modal-content">
  <div class="modal-header">
    <h5 class="modal-title"><%== __('VAT Number Lookup') %></h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
  </div>
  <div class="modal-body">
    <div class="mb-3">
      <label for="vatlookup-input" class="form-label"><%== __('VAT Number') %></label>
      <div class="input-group">
        <input type="text" class="form-control" id="vatlookup-input" placeholder="SE556012345601">
        <button class="btn btn-primary" type="button" id="vatlookup-btn"><%== __('Lookup') %></button>
      </div>
      <div class="form-text"><%== __('Enter VAT number with country prefix (e.g., SE, DE, FR)') %></div>
    </div>
    <div id="vatlookup-result" class="d-none">
      <hr>
      <div id="vatlookup-error" class="alert alert-danger d-none"></div>
      <div id="vatlookup-info" class="d-none">
        <dl class="row mb-0">
          <dt class="col-sm-4"><%== __('Status') %></dt>
          <dd class="col-sm-8"><span id="vat-status" class="badge bg-success"><%== __('Valid') %></span></dd>
          <dt class="col-sm-4"><%== __('Name') %></dt>
          <dd class="col-sm-8" id="vat-name"></dd>
          <dt class="col-sm-4"><%== __('Address') %></dt>
          <dd class="col-sm-8" id="vat-address"></dd>
        </dl>
      </div>
    </div>
    <div id="vatlookup-spinner" class="text-center d-none">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden"><%== __('Loading...') %></span>
      </div>
    </div>
  </div>
</div>
