<form name="searchadmins" class="row mb-3 g-2">
  <div class="col-md-6">
    <div class="input-group">
      <input class="form-control" type="text" name="searchterm" placeholder="<%== __('Search for admin') %>..." aria-label="<%== __('Search') %>">
      <button class="btn btn-primary" type="submit" aria-label="<%== __('Search') %>">
        <%== icon 'search', {} %>
      </button>
    </div>
  </div>
  <div class="col-md-6 text-end">
    <a href="<%== url_for('email_admin_edit') %>" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#universalmodal">
      <%== icon 'plus', {} %>
      <span><%== __('Add admin') %></span>
    </a>
  </div>
</form>

<table id="admins" class="table table-striped table-sm">
  <thead>
    <tr>
      <th><%== __('Username') %></th>
      <th><%== __('Domains') %></th>
      <th><%== __('Active') %></th>
      <th><%== __('Superadmin') %></th>
      <th class="text-end"><%== __('Actions') %></th>
    </tr>
  </thead>
  <tbody id="adminsList">
  </tbody>
</table>

<div class="modal fade" id="domainsModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%== __('Managed domains') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <div class="input-group">
            <input type="text" id="domainSearch" class="form-control" placeholder="<%== __('Search domain to add') %>..." autocomplete="off">
          </div>
          <ul id="domainSearchResults" class="list-group mt-1"></ul>
        </div>
        <h6><%== __('Currently managed') %></h6>
        <ul id="domainsList" class="list-group"></ul>
      </div>
    </div>
  </div>
</div>

<nav id="pagination" aria-label="<%== __('Page navigation') %>">
  <ul class="pagination justify-content-center">
  </ul>
</nav>
