<form id="domainForm" class="mb-4">
  <div class="row">
    <div class="col-md-4 mb-3">
      <label for="customerSearch" class="form-label"><%== __('Customer') %></label>
      <input type="text" id="customerSearch" class="form-control mb-2" placeholder="<%== __('Search customer (min 3 chars)...') %>">
      <select id="customerid" name="customerid" class="form-select" required>
        <option value=""><%== __('Select customer') %></option>
      </select>
    </div>
    <div class="col-md-4 mb-3">
      <label for="domain" class="form-label"><%== __('Domain name') %></label>
      <input type="text" id="domain" name="domain" class="form-control" required placeholder="example.com">
    </div>
    <div class="col-md-4 mb-3">
      <label for="description" class="form-label"><%== __('Description') %></label>
      <input type="text" id="description" name="description" class="form-control">
    </div>
  </div>

  <div class="row">
    <div class="col-md-4 mb-3">
      <div class="form-check">
        <input type="checkbox" class="form-check-input" id="isAliasDomain" name="isAliasDomain">
        <label class="form-check-label" for="isAliasDomain"><%== __('Alias domain') %></label>
        <div class="form-text"><%== __('Route all mail to another domain') %></div>
      </div>
    </div>
    <div class="col-md-4 mb-3" id="targetDomainField" style="display: none;">
      <label for="targetDomain" class="form-label"><%== __('Target domain') %></label>
      <select id="targetDomain" name="targetDomain" class="form-select">
        <option value=""><%== __('Select target domain') %></option>
      </select>
    </div>
    <div class="col-md-4 mb-3">
      <div class="form-check">
        <input type="checkbox" class="form-check-input" id="active" name="active" checked>
        <label class="form-check-label" for="active"><%== __('Active') %></label>
      </div>
    </div>
  </div>

  <div class="row" id="limitsRow">
    <div class="col-md-3 mb-3">
      <label for="aliases" class="form-label"><%== __('Forwards') %></label>
      <input type="number" id="aliases" name="aliases" class="form-control" value="<%== $c->app->config->{manager}->{email}->{domain}->{aliases} // 0 %>">
      <div class="form-text">-1 = <%== __('disable') %>, 0 = <%== __('unlimited') %></div>
    </div>
    <div class="col-md-3 mb-3">
      <label for="mailboxes" class="form-label"><%== __('Mailboxes') %></label>
      <input type="number" id="mailboxes" name="mailboxes" class="form-control" value="<%== $c->app->config->{manager}->{email}->{domain}->{mailboxes} // 0 %>">
      <div class="form-text">-1 = <%== __('disable') %>, 0 = <%== __('unlimited') %></div>
    </div>
    <div class="col-md-3 mb-3">
      <label for="maxquota" class="form-label"><%== __('Mailbox quota') %> (MB)</label>
      <input type="number" id="maxquota" name="maxquota" class="form-control" value="<%== $c->app->config->{manager}->{email}->{domain}->{maxquota} // 0 %>">
      <div class="form-text">-1 = <%== __('disable') %>, 0 = <%== __('unlimited') %></div>
    </div>
    <div class="col-md-3 mb-3">
      <label for="quota" class="form-label"><%== __('Domain quota') %> (MB)</label>
      <input type="number" id="quota" name="quota" class="form-control" value="<%== $c->app->config->{manager}->{email}->{domain}->{quota} // 0 %>">
      <div class="form-text">-1 = <%== __('disable') %>, 0 = <%== __('unlimited') %></div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary" id="submitBtn"><%== __('Save') %></button>
    <button type="button" class="btn btn-danger" id="deleteBtn" style="display: none;"><%== __('Delete') %></button>
    <a href="<%== url_for('email_index') %>" class="btn btn-secondary"><%== __('Back') %></a>
  </div>
</form>

<div id="aliasDomainsSection" class="mb-4" style="display: none;">
  <h5 class="orange p-2 d-flex justify-content-between align-items-center">
    <%== __('Alias domains') %>
    <button type="button" class="btn btn-sm btn-primary" id="addAliasDomainBtn"><%== icon 'plus', {} %></button>
  </h5>
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th><%== __('Alias domain') %></th>
        <th class="text-end"><%== __('Actions') %></th>
      </tr>
    </thead>
    <tbody id="aliasDomainsList">
    </tbody>
  </table>
</div>

<div id="mailboxesSection" class="mb-4" style="display: none;">
  <h5 class="orange p-2 d-flex justify-content-between align-items-center">
    <%== __('Mailboxes') %>
    <button type="button" class="btn btn-sm btn-primary" id="addMailboxBtn"><%== icon 'plus', {} %></button>
  </h5>
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th><%== __('Username') %></th>
        <th><%== __('Name') %></th>
        <th class="text-end"><%== __('Actions') %></th>
      </tr>
    </thead>
    <tbody id="mailboxesList">
    </tbody>
  </table>
</div>

<div id="aliasesSection" class="mb-4" style="display: none;">
  <h5 class="orange p-2 d-flex justify-content-between align-items-center">
    <%== __('Forwarding') %>
    <button type="button" class="btn btn-sm btn-primary" id="addAliasBtn"><%== icon 'plus', {} %></button>
  </h5>
  <table class="table table-striped table-sm">
    <thead>
      <tr>
        <th><%== __('Address') %></th>
        <th><%== __('Forwards to') %></th>
        <th class="text-end"><%== __('Actions') %></th>
      </tr>
    </thead>
    <tbody id="aliasesList">
    </tbody>
  </table>
</div>

<div class="modal fade" id="vacationModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%== __('Vacation / Auto-reply') %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="vacationForm">
          <input type="hidden" id="vacationEmail">
          <div class="mb-3">
            <label for="vacationSubject" class="form-label"><%== __('Subject') %></label>
            <input type="text" class="form-control" id="vacationSubject" placeholder="<%== __('Out of office') %>">
          </div>
          <div class="mb-3">
            <label for="vacationBody" class="form-label"><%== __('Message') %></label>
            <textarea class="form-control" id="vacationBody" rows="4"></textarea>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="vacationFrom" class="form-label"><%== __('Active from') %></label>
              <input type="date" class="form-control" id="vacationFrom">
            </div>
            <div class="col-md-6 mb-3">
              <label for="vacationUntil" class="form-label"><%== __('Active until') %></label>
              <input type="date" class="form-control" id="vacationUntil">
            </div>
          </div>
          <div class="mb-3">
            <label for="vacationInterval" class="form-label"><%== __('Reply interval (seconds)') %></label>
            <input type="number" class="form-control" id="vacationInterval" value="0" min="0">
            <div class="form-text"><%== __('0 = reply once per sender') %></div>
          </div>
          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" id="vacationActive">
            <label class="form-check-label" for="vacationActive"><%== __('Active') %></label>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-danger me-auto" id="deleteVacationBtn" style="display: none;"><%== __('Delete') %></button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%== __('Cancel') %></button>
        <button type="button" class="btn btn-primary" id="saveVacationBtn"><%== __('Save') %></button>
      </div>
    </div>
  </div>
</div>
