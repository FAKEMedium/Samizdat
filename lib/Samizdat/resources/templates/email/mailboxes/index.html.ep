<form name="searchmailboxes" class="row mb-3 g-2">
  <div class="col-md-6">
    <div class="input-group">
      <input class="form-control" type="text" name="searchterm" placeholder="<%== __('Search for mailbox') %>..." aria-label="<%== __('Search') %>">
      <button class="btn btn-primary" type="submit" aria-label="<%== __('Search') %>">
        <%== icon 'search', {} %>
      </button>
    </div>
  </div>
  <div class="col-md-6 text-end">
  </div>
</form>

<table id="mailboxes" class="table table-striped table-sm">
  <thead>
    <tr>
      <th><%== __('Username') %></th>
      <th><%== __('Name') %></th>
      <th><%== __('Domain') %></th>
      <th class="text-end"><%== __('Actions') %></th>
    </tr>
  </thead>
  <tbody id="mailboxesList">
  </tbody>
</table>

<nav id="pagination" aria-label="<%== __('Page navigation') %>">
  <ul class="pagination justify-content-center">
  </ul>
</nav>
