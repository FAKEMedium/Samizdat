<form name="searchweb" method="get" action="<%== config->{manager}->{url} %>web">
  <div class="row mb-3">
    <div class="input-group">
      <input class="form-control" type="text" id="searchterm" name="searchterm" aria-label="<%== __x('Search field for {what}', what => __('content')) %>" placeholder="<%== __('Search web content') %>...">
      <button class="btn btn-primary btn-sm rounded-lg" type="submit" aria-label="<%== __('Search') %>">
        <%== icon 'search', {} %>
      </button>
    </div>
  </div>
</form>
<a class="badge rounded-pill text-bg-primary admin" href="#" data-modal-url="<%== url_for('web_new') %>"><%== __('Add content') %></a>
<a class="badge rounded-pill text-bg-primary admin" href="<%== url_for('web_src_root') %>"><%== __('Source files') %></a>
<a class="badge rounded-pill text-bg-primary admin" href="<%== url_for('web_menus') %>"><%== __('Menus') %></a>
<a class="badge rounded-pill text-bg-primary admin" href="<%== url_for('web_languages') %>"><%== __('Languages') %></a>