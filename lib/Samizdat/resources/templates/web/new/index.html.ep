% my $default_lang = stash('default_language') // 'en';
% my $has_anthropic = stash('has_anthropic') // 0;
<div class="modal-content" data-languages-url="<%= url_for('web_languages') %>" data-filetree-url="<%= url_for('Web.filetree.list') %>" data-src-url="<%= url_for('Web.src.list') %>" data-source-url="<%= url_for('web_source_root') %>" data-default-lang="<%= $default_lang %>" data-has-anthropic="<%= $has_anthropic ? 1 : 0 %>" data-translate-url="<%= url_for('Web.translate') %>">
  <div class="modal-header">
    <h5 class="modal-title" id="modalTitle"></h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
  </div>
  <div class="modal-body" id="modalBody">
    <!-- Content populated by JavaScript -->
  </div>
  <div class="modal-footer" id="modalFooter">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%== __('Cancel') %></button>
  </div>
</div>
