<form name="searchuser" method="get" action="<%== url_for("account_index") %>" id="accountSearchForm">
  <div class="row mb-3">
    <div class="input-group">
      <input class="form-control" type="text" name="searchterm" aria-label="<%== __x('Search field for {what}', what => __('user')) %>" placeholder="<%== __('Search for user or group') %>..." />
      <button class="btn btn-primary btn-sm rounded-lg" type="submit" aria-label="<%== __('Search') %>">
        <%== icon 'search', {} %>
      </button>
    </div>
    <div>
      <div class="form-check form-check-inline">
        <input class="form-check-input" type="radio" id="searchuser" name="searchtype" value="user" checked="checked">
        <label class="form-check-label" for="searchuser"><%== __('Users') %></label>
      </div>
      <div class="form-check form-check-inline ms-1">
        <input class="form-check-input" type="radio" id="searchgroup" name="searchtype" value="group">
        <label class="form-check-label" for="searchgroup"><%== __('Groups') %></label>
      </div>
      <div class="form-check form-check-inline ms-1">
        <input class="form-check-input" type="radio" id="searchprivilege" name="searchtype" value="privilege">
        <label class="form-check-label" for="searchprivilege"><%== __('Privileges') %></label>
      </div>
    </div>
  </div>
</form>
<a class="badge rounded-pill text-bg-primary admin" href="<%== url_for('account_new') %>"><%== __('Add user') %></a>
<a class="badge rounded-pill text-bg-primary admin" href="<%== url_for('account_group_new') %>"><%== __('Add group') %></a>
<a class="badge rounded-pill text-bg-primary admin" href="<%== config->{manager}->{url} %>user/privilege"><%== __('Privileges') %></a>
<a class="badge rounded-pill text-bg-primary admin" href="<%== config->{manager}->{url} %>user/privilege/set"><%== __('Privilege sets') %></a>
<a class="badge rounded-pill text-bg-primary admin" href="<%== config->{manager}->{url} %>user/role"><%== __('Roles') %></a>