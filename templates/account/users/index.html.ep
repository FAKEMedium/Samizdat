<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2><%== __('Users') %></h2>
    <a href="<%== url_for('account_new') %>" class="btn btn-primary d-none" id="addUserBtn"><%== __('Add user') %></a>
  </div>

  <table id="users" class="table table-sm table-striped">
    <thead>
      <tr>
        <th><%== __('Username') %></th>
        <th><%== __('Name') %></th>
        <th></th>
        <th><%== __('Created') %></th>
        <th class="d-none" id="statusHeader"><%== __('Status') %></th>
      </tr>
    </thead>
    <tbody>
      <!-- Populated by JavaScript -->
    </tbody>
  </table>

  <nav aria-label="User pagination">
    <ul class="pagination pagination-sm" id="userPagination"></ul>
  </nav>
</div>
