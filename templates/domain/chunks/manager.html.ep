<form name="searchdomain" method="get" action="<%== url_for('domain_index') %>">
  <div class="row mb-3">
    <div class="input-group">
      <input class="form-control" type="text" name="searchterm" aria-label="<%== __x('Search field for {what}', what => __('domain')) %>" placeholder="<%== __('Search for domain') %>...">
      <button class="btn btn-primary btn-sm rounded-lg" type="submit" aria-label="<%== __('Search') %>">
        <%== icon 'search', {} %>
      </button>
    </div>
  </div>
</form>
<a class="badge rounded-pill text-bg-primary" href="<%== url_for('domain_register') %>"><%== __('Register') %></a>
<a class="badge rounded-pill text-bg-primary admin" href="#" id="addContactBtn"><%== __('Add contact') %></a>
<a class="badge rounded-pill text-bg-primary" href="<%== url_for('domain_transfer') %>"><%== __('Transfer') %></a>
<a class="badge rounded-pill text-bg-primary" href="<%== url_for('domain_index') %>?searchterm=expiring"><%== __('Expiring domains') %></a>
<a class="badge rounded-pill text-bg-primary admin" href="<%== url_for('rtr_index') %>">RR</a>
<a class="badge rounded-pill text-bg-primary admin" href="https://dm.realtimeregister.com/docs/api/">RR API</a>