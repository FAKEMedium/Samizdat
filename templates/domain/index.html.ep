<form class="align-items-center d-print-none mb-3 d-flex flex-wrap gap-2" id="dataform">
  <div class="input-group flex-grow-1" style="min-width: 200px; max-width: 400px;">
    <input type="text" class="form-control" name="searchterm" id="searchterm" placeholder="<%== __('Search domain') %>">
    <button id="searchbutton" type="submit" class="btn btn-primary" title="<%== __('Search') %>">
      <%== icon 'search', {} %>
    </button>
  </div>
  <select id="filterStatus" class="form-select" style="width: auto;">
    <option value=""><%== __('All domains') %></option>
    <option value="expiring"><%== __('Expiring') %></option>
    <option value="dontrenew"><%== __('Do not renew') %></option>
  </select>
  <select id="customerFilter" class="form-select" style="width: auto;">
    <option value=""><%== __('All customers') %></option>
  </select>
</form>

<div class="mb-2 d-flex justify-content-between align-items-center">
  <div id="bulk-actions" style="display: none;">
    <span class="me-2"><span id="selected-count">0</span> <%== __('selected') %></span>
    <div class="btn-group btn-group-sm">
      <button type="button" class="btn btn-outline-primary" id="bulk-renew"><%== __('Renew') %></button>
      <button type="button" class="btn btn-outline-secondary" id="bulk-export"><%== __('Export') %></button>
    </div>
  </div>
  <div id="pagination-info" class="text-muted small"></div>
</div>

<table id="domains" class="table table-striped table-sm sortable">
  <thead>
    <tr>
      <th><input type="checkbox" id="select-all" title="<%== __('Select all') %>"></th>
      <th><%== __('Domain') %></th>
      <th><%== __('Customer') %></th>
      <th><%== __('Expiry') %></th>
    </tr>
  </thead>
  <tbody>
    <!-- Data will be injected here by JavaScript -->
  </tbody>
</table>

<nav id="pagination" aria-label="<%== __('Page navigation') %>">
  <ul class="pagination pagination-sm justify-content-center">
    <!-- Pagination will be injected here by JavaScript -->
  </ul>
</nav>
