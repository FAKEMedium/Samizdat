<form name="searchadmins" class="row mb-3 g-2">
  <div class="col-md-6">
    <div class="input-group">
      <input class="form-control" type="text" name="searchterm" placeholder="<%== __('Search for admin') %>..." aria-label="<%== __('Search') %>">
      <button class="btn btn-primary" type="submit" aria-label="<%== __('Search') %>">
        <%== icon 'search', {} %>
      </button>
    </div>
  </div>
  <div class="col-md-6 text-end">
    <a href="<%== url_for('email_admin_edit') %>" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#universalmodal">
      <%== icon 'plus', {} %>
      <span><%== __('Add admin') %></span>
    </a>
  </div>
</form>

<table id="admins" class="table table-striped table-sm">
  <thead>
    <tr>
      <th><%== __('Username') %></th>
      <th><%== __('Active') %></th>
      <th><%== __('Superadmin') %></th>
      <th class="text-end"><%== __('Actions') %></th>
    </tr>
  </thead>
  <tbody id="adminsList">
  </tbody>
</table>

<nav id="pagination" aria-label="<%== __('Page navigation') %>">
  <ul class="pagination justify-content-center">
  </ul>
</nav>
