<form name="searchdomains" class="row mb-3 g-2">
  <div class="col-md-4">
    <div class="input-group">
      <input class="form-control" type="text" name="searchterm" placeholder="<%== __('Search for mail domain') %>..." aria-label="<%== __('Search') %>">
      <button class="btn btn-primary" type="submit" aria-label="<%== __('Search') %>">
        <%== icon 'search', {} %>
      </button>
    </div>
  </div>
  <div class="col-md-4">
    <input class="form-control" type="text" name="customerSearch" placeholder="<%== __('Filter by customer') %>..." autocomplete="off">
    <input type="hidden" name="customerid">
  </div>
  <div class="col-md-4 text-end">
    <a href="<%== url_for('email_domain_new') %>" class="btn btn-primary">
      <%== icon 'plus', {} %>
      <span><%== __('Add domain') %></span>
    </a>
  </div>
</form>

<table id="emails" class="table table-striped table-sm">
  <thead id="emailsHead">
    <tr>
      <th><%== __('Domain') %></th>
      <th><%== __('Description') %></th>
      <th class="text-end"><%== __('Actions') %></th>
    </tr>
  </thead>
  <tbody id="emailsList">
  </tbody>
</table>

<nav id="pagination" aria-label="<%== __('Page navigation') %>">
  <ul class="pagination justify-content-center">
  </ul>
</nav>
