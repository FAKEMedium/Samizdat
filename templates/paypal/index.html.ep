% # PayPal payment panel
<div class="container-fluid mt-4">
  <div class="row">
    <div class="col-12">
      <h2><%= __('PayPal Payments') %></h2>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row mt-4" id="stats-cards">
    <div class="col-md-3">
      <div class="card text-white bg-success mb-3">
        <div class="card-header"><%= __('Balance') %></div>
        <div class="card-body">
          <h4 class="card-title" id="balance-amount">-</h4>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-primary mb-3">
        <div class="card-header"><%= __('Completed') %></div>
        <div class="card-body">
          <h5 class="card-title" id="completed-amount">-</h5>
          <p class="card-text" id="completed-count">-</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-warning mb-3">
        <div class="card-header"><%= __('Pending') %></div>
        <div class="card-body">
          <h5 class="card-title" id="pending-amount">-</h5>
          <p class="card-text" id="pending-count">-</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-white bg-danger mb-3">
        <div class="card-header"><%= __('Refunded/Failed') %></div>
        <div class="card-body">
          <p class="card-text" id="refunded-count">-</p>
          <p class="card-text" id="failed-count">-</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Payments Table -->
  <div class="row mt-4">
    <div class="col-12">
      <h4><%= __('Recent Payments') %></h4>
      <div class="table-responsive">
        <table class="table table-striped table-hover" id="payments-table">
          <thead>
            <tr>
              <th><%= __('Date') %></th>
              <th><%= __('Transaction ID') %></th>
              <th><%= __('Status') %></th>
              <th><%= __('Payer Email') %></th>
              <th><%= __('Amount') %></th>
              <th><%= __('Currency') %></th>
              <th><%= __('Item Number') %></th>
            </tr>
          </thead>
          <tbody id="payments-tbody">
            <tr>
              <td colspan="7" class="text-center"><%= __('Loading...') %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
