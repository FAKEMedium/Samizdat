<div class="d-flex justify-content-between align-items-start w-100">
  <div>
    <a href="<%= url_for('rtr_domains') %>" class="btn btn-primary align-self-start">
      <%== icon 'globe' %>
      <span class="d-sm-inline d-none"><%== __('Domains') %></span>
    </a>
    <a href="<%= url_for('rtr_contacts') %>" class="btn btn-primary align-self-start">
      <%== icon 'people' %>
      <span class="d-sm-inline d-none"><%== __('Contacts') %></span>
    </a>
  </div>
  <div id="pagination-controls" class="btn-group align-self-start" role="group">
    <!-- Pagination will be inserted here by JavaScript -->
  </div>
</div>
