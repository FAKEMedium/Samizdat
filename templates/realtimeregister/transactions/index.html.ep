<div class="card">
  <div class="card-header">
    <h2 class="h5 mb-0"><%== __('Financial Transactions') %></h2>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-sm table-striped table-hover" id="transactionsTable">
        <thead>
          <tr>
            <th><%== __('Date') %></th>
            <th><%== __('Type') %></th>
            <th><%== __('Identifier') %></th>
            <th><%== __('Action') %></th>
            <th class="text-end"><%== __('Amount') %> (EUR)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td colspan="5" class="text-center">
              <div class="spinner-border spinner-border-sm" role="status">
                <span class="visually-hidden"><%== __('Loading...') %></span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
