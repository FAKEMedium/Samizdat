<form class="align-items-center d-print-none mb-3 d-flex justify-content-between" id="dataform">
  <div class="col me-auto">
    <div class="input-group">
      <input type="text" class="form-control" name="searchterm" id="searchterm" placeholder="<%== __('Search menus...') %>">
      <button id="searchbutton" type="submit" class="btn btn-primary">
        <%== icon 'search', {} %>
        <span class="d-sm-inline d-none mx-1"><%== __('Search') %></span>
      </button>
    </div>
  </div>
  <div class="col justify-content-sm-end input-group d-flex">
    <button type="button" id="newMenu" class="btn btn-primary">
      <%== icon 'plus-circle-fill', {} %>
      <span class="d-sm-inline d-none mx-1"><%== __('New menu') %></span>
    </button>
  </div>
</form>

<table id="menus" class="table table-striped table-sm sortable">
  <thead>
    <tr class="orange">
      <th class="px-2"><%== __('ID') %></th>
      <th class="px-2"><%== __('Name') %></th>
      <th class="text-end px-2"><%== __('Actions') %></th>
    </tr>
  </thead>
  <tbody>
    <!-- Menu data will be dynamically populated via AJAX -->
  </tbody>
</table>
