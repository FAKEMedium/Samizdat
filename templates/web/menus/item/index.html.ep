<div class="d-flex justify-content-between align-items-center mb-3">
  <a href="<%== url_for('web_menu', menuid => $menu->{menuid}) %>" class="btn btn-secondary">
    <%== icon 'arrow-left', {} %> <%== __('Back to menu') %>
  </a>
</div>

<div class="card">
  <div class="card-header">
    <h5 class="mb-0"><%= $title %></h5>
  </div>
  <div class="card-body">
    <form id="itemForm">
      <input type="hidden" id="menuitemid" value="<%= $item->{menuitemid} // 'new' %>">
      
      <div class="mb-3">
        <label for="itemPath" class="form-label"><%== __('URI Path') %></label>
        <input type="text" class="form-control" id="itemPath" name="path" placeholder="/example/path">
        <div class="form-text"><%== __('Leave empty for items without a link') %></div>
      </div>

      <div class="mb-3">
        <label for="parentSelect" class="form-label"><%== __('Parent Item') %></label>
        <select id="parentSelect" name="parentid" class="form-select">
          <option value=""><%== __('(No parent - top level)') %></option>
          <!-- Parent options populated by JS -->
        </select>
      </div>

      <hr>
      <h6><%== __('Titles by Language') %></h6>
      <div id="titleFields">
        <!-- Language title fields populated by JS -->
      </div>

      <hr>
      <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-primary"><%== __('Save') %></button>
        <% if ($item->{menuitemid}) { %>
        <button type="button" id="deleteItem" class="btn btn-danger"><%== __('Delete') %></button>
        <% } %>
      </div>
    </form>
  </div>
</div>
